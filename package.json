{
  "name": "fas-tap-mining",
  "version": "3.0.0",
  "private": true,
  "description": "Enterprise-grade multi-token mining pool on TON - MineX + TonBitcoin + Meridian",
  "scripts": {
    "dev": "vercel dev",
    "deploy": "vercel --prod",
    "start": "node bot/main.js",
    "bot": "node bot/main.js",
    "workers": "pm2 start ecosystem.config.js",
    "workers:stop": "pm2 stop all",
    "workers:restart": "pm2 restart all",
    "workers:logs": "pm2 logs",
    "migrate": "node scripts/migrate.js",
    "setup": "node scripts/setup.js",
    "health": "node scripts/health-check.js",
    "db:migrate": "node database/migrate.js",
    "db:seed": "node database/seed.js"
  },
