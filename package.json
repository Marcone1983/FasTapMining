    "@tma.js/sdk": "^1.0.0",
    "@ton/core": "^0.56.0",
    "@ton/crypto": "^3.2.0",
    "@ton/ton": "^13.0.0",
    "@tonconnect/protocol": "^2.0.0",
    "@tonconnect/ui": "^2.0.0",
    "axios": "^1.13.3",
    "bull": "^4.12.0",
    "compression": "^1.7.4",
    "cors": "^2.8.5",
    "dotenv": "^16.4.0",
    "ethereum-cryptography": "^2.1.0",
